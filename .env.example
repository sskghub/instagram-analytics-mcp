# Copy to .env and fill in. Never commit .env.
#
# Tokens are Instagram User Access Tokens (they start with IGAA...), created in the Meta
# dashboard under: Instagram -> API setup with Instagram login -> Generate access tokens.
#
# Use "API setup with Instagram login", NOT "API setup with Facebook login". The dashboard
# banner claiming insights require Facebook Login refers to hashtag and account-level
# insights. Per-reel media insights work on Instagram Login and return
# ig_reels_avg_watch_time, which is the metric this server is built around.
#
# The account id is the numeric Instagram user id shown next to the token.
# Delete any account block you do not use; missing keys are skipped, not errors.

IG_TELUGU_TOKEN=
IG_TELUGU_ACCOUNT_ID=

IG_ENGLISH_TOKEN=
IG_ENGLISH_ACCOUNT_ID=

IG_ENTECH_TOKEN=
IG_ENTECH_ACCOUNT_ID=

# Optional. Used only by refresh_tokens.py to alert when a refresh fails.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
