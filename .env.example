# Copy to .env and fill in. Never commit .env.
#
# Full walkthrough for getting these values: see SETUP.md
#
# Accounts are discovered from these variable names, so you never edit any code.
# The pattern is:
#
#     IG_ACCOUNT_<NAME>_TOKEN     the IGAA... Instagram User Access Token
#     IG_ACCOUNT_<NAME>_ID        the numeric Instagram user id
#
# <NAME> is yours to choose. Letters and digits only, no underscores. It becomes the
# account name you use when asking questions, lowercased. So IG_ACCOUNT_MAIN_* below
# means you can ask "how did my main account do this week".
#
# One account is enough. Add more blocks only if you run more than one.

IG_ACCOUNT_MAIN_TOKEN=
IG_ACCOUNT_MAIN_ID=

# Example of a second account. Delete if you only have one.
# IG_ACCOUNT_SECOND_TOKEN=
# IG_ACCOUNT_SECOND_ID=

# Optional. Used only by refresh_tokens.py to alert you when a token refresh fails.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
